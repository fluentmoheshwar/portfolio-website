---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/Main.astro";
import domain from "../../lib/domain.ts";
import { createBreadcrumbSchema } from "../../lib/schemas";

const posts = await getCollection("posts");
---

<MainLayout
  canonical={`https://${domain}/posts/`}
  lang="en"
  title="Posts - Moheshwar Amarnath Biswas"
  description="Posts by Moheshwar Amarnath Biswas"
  socialImage="/images/social/home.png"
  keywords="posts, blog, articles, Moheshwar Amarnath Biswas"
  additionalSchemas={[
    createBreadcrumbSchema([
      { name: "Home", url: `https://${domain}` },
      { name: "Posts" },
    ]) as unknown as Record,
  ]}
>
  <h1 class="p-5 text-center text-3xl">Posts by Moheshwar Amarnath Biswas</h1>
  <div class="m-auto mb-6 text-center">
    <a
      href="/rss.xml"
      target="_blank"
      class="btn btn-outline btn-primary"
      aria-label="Subscribe to RSS Feed"
    >
      📡 Subscribe to RSS Feed
    </a>
  </div>
  <ul class="m-auto list-disc">
    {
      posts.map((post) => (
        <li>
          <a
            href={`/posts/${post.id}/`}
            class="post-title text-xl underline decoration-pink-500 duration-500 hover:underline hover:decoration-sky-500 sm:text-3xl"
          >
            {post.data.title}
          </a>
          <p class="text-base sm:text-lg">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</MainLayout>
