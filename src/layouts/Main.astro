---
import Footer from "../components/layouts/Footer.astro";
import Navbar from "../components/layouts/Navbar.astro";
import SocialTags from "../components/layouts/SocialTags.astro";
import SchemaOrg from "../components/schemas/SchemaOrg.astro";
import { createPersonSchema, createWebsiteSchema } from "../lib/schemas";
import "../styles/index.css";

export interface Props {
  lang: string;
  title: string;
  description: string;
  socialImage: string;
  canonical?: string;
  keywords: string;
  additionalSchemas?: Record<string, unknown>[];
}
const {
  lang,
  title,
  description,
  socialImage,
  canonical,
  keywords,
  additionalSchemas = [],
} = Astro.props;

// Extend Window typing so `window.secrets` is allowed
declare global {
  interface Window {
    secrets?: { girlfriend: string; wife: string };
  }
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <!-- Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="girlfriend" content="Somudre Sarkar" />
    <meta name="wife" content="Somudre Sarkar" />
    <link rel="preconnect" href="https://www.clarity.ms" />
    <link rel="preconnect" href="https://scripts.clarity.ms" />
    <link
      rel="preload"
      href="https://keepandroidopen.org/banner.js"
      as="script"
    />
    <SocialTags
      title={title}
      description={description}
      socialImage={socialImage}
    />
    <SchemaOrg schema={createPersonSchema() as unknown as Record} />
    <SchemaOrg schema={createWebsiteSchema() as unknown as Record} />
    {additionalSchemas.map((schema) => <SchemaOrg schema={schema} />)}
    <noscript>
      <p class="m-auto bg-pink-800 p-5 text-center text-2xl text-white">
        JavaScript is disabled! Some features may not function correctly!
      </p>
    </noscript>

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed"
      href="/rss.xml"
    />
    <link rel="canonical" href={canonical} />
  </head>

  <body class="flex h-screen flex-col">
    <Navbar />
    <slot />
    <Footer />
    <script>
      import Clarity from "@microsoft/clarity";

      Clarity.init("pojiqcvx89");

      const secrets = {
        girlfriend: "Somudre Sarkar",
        wife: "Somudre Sarkar",
      };
      window.secrets = secrets;
    </script>
    <script src="https://keepandroidopen.org/banner.js" defer async is:inline
    ></script>
  </body>
</html>
