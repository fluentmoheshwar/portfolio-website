---
import {
  FaCss3Alt,
  FaGitAlt,
  FaHtml5,
  FaLanguage,
  FaNodeJs,
  FaPython,
  FaSquareJs,
} from "react-icons/fa6";
import { PiMicrosoftExcelLogoFill } from "react-icons/pi";
import { SiAstro, SiTailwindcss } from "react-icons/si";
import { TbBrandAdobePhotoshop } from "react-icons/tb";
---

<section>
  <h2
    class="m-4 text-center text-2xl underline decoration-pink-500 sm:text-3xl"
  >
    Skills
  </h2>
  <ul
    class="grid items-center justify-center px-4 py-3 sm:grid-cols-[repeat(2,minmax(0,0.2fr))]"
  >
    <li>
      <span class="*:inline"><FaLanguage aria-label="Languages" /></span> Bangla,
      English and Hindi
    </li>
    <li>
      <span class="*:inline"><FaHtml5 aria-label="HTML" /></span> HTML and <span
        class="*:inline"><FaCss3Alt aria-label="CSS" /></span
      > CSS
    </li>
    <li>
      <span class="*:inline"><FaSquareJs aria-label="JavaScript" /></span> JavaScript
      and TypeScript
    </li>
    <li>
      <span class="*:inline"><FaPython aria-label="Python" /></span> Python
    </li>
    <li>
      <span class="*:inline"><SiTailwindcss aria-label="TailwindCSS" /></span> TailwindCSS
    </li>
    <li>
      <span class="*:inline"><SiAstro aria-label="Astro" /></span> Astro
    </li>
    <li>
      <span class="*:inline"><FaNodeJs aria-label="Node.js" /></span> Node.js and
      Express.js
    </li>
    <li><span class="*:inline"><FaGitAlt aria-label="Git" /></span> Git</li>
    <li>
      <span class="*:inline"
        ><PiMicrosoftExcelLogoFill aria-label="Microsoft Excel" /></span
      > Microsoft Excel
    </li>
    <li>
      <span class="*:inline"
        ><TbBrandAdobePhotoshop aria-label="Adobe Photoshop" /></span
      > Adobe Photoshop
    </li>
  </ul>
</section>
